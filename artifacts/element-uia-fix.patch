+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+// @vitest-environment happy-dom
+
+import React, { StrictMode } from "react";
+import { render, waitFor, cleanup } from "test-utils-rtl";
+import { afterEach, expect, it, vi } from "vitest";
+import { createTestClient } from "test-utils";
+
+import InteractiveAuthComponent from "./InteractiveAuth";
+
+afterEach(cleanup);
+
+it("starts only one authentication request across the StrictMode remount", async () => {
+    const makeRequest = vi.fn().mockResolvedValue({});
+    const onAuthFinished = vi.fn();
+    render(
+        <StrictMode>
+            <InteractiveAuthComponent
+                matrixClient={createTestClient()}
+                makeRequest={makeRequest}
+                onAuthFinished={onAuthFinished}
+            />
+        </StrictMode>,
+    );
+
+    await waitFor(() => expect(onAuthFinished).toHaveBeenCalledWith(true, {}, expect.anything()));
+    expect(makeRequest).toHaveBeenCalledTimes(1);
+    expect(onAuthFinished).toHaveBeenCalledTimes(1);
+});
