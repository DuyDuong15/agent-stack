# Defaults for running the backend directly on Windows. Compose overrides service DNS/bind addresses.
EMPLOYEE_API_URL=http://127.0.0.1:8011
TICKET_API_URL=http://127.0.0.1:8012
GRAPHQL_URL=http://127.0.0.1:8013/graphql
MATRIX_URL=http://127.0.0.1:8008
MATRIX_USER_ID=@reviewer:localhost
MATRIX_ROOM_ID=!replace-with-your-room-id:localhost
MATRIX_CREDENTIALS_FILE=matrix-session.local.json
REST_HOST=127.0.0.1
GRAPHQL_HOST=127.0.0.1
MCP_HOST=0.0.0.0
EMPLOYEE_PORT=8011
TICKET_PORT=8012
GRAPHQL_PORT=8013
MCP_PORT=8005
REST_TIMEOUT_MS=5000
GRAPHQL_TIMEOUT_MS=25000
EMPLOYEE_DB=ticket-service/data/employee.sqlite
TICKET_DB=ticket-service/data/ticket.sqlite
DRAFT_DB=mcp-ping/data/drafts.sqlite
